/ {
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "none"; // Berättar för ZMK att det inte finns några dioder

        /* Dina 4 Rader */
        row-gpios
            = <&gpio0 13 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* P0.13 - Rad 1 */
            , <&gpio0 15 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* P0.15 - Rad 2 */
            , <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* P0.17 - Rad 3 */
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* P0.20 - Rad 4 */
            ;

        /* Dina 3 Kolumner */
        col-gpios
            = <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* P0.22 - Kolumn 1 */
            , <&gpio0 24 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* P0.24 - Kolumn 2 */
            , <&gpio1  0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>  /* P1.00 - Kolumn 3 */
            ;
    };
};
