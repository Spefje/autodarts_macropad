/ {
    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        label = "KSCAN";
        diode-direction = "col2row"; // Ändra till row2col om dina dioder är vända åt andra hållet

        /* Dina 4 Rader */
        row-gpios
            = <&gpio0 13 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.13 - Rad 1 */
            , <&gpio0 15 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.15 - Rad 2 */
            , <&gpio0 17 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.17 - Rad 3 */
            , <&gpio0 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>  /* P0.20 - Rad 4 */
            ;

        /* Dina 3 Kolumner */
        col-gpios
            = <&gpio0 22 GPIO_ACTIVE_HIGH>  /* P0.22 - Kolumn 1 */
            , <&gpio0 24 GPIO_ACTIVE_HIGH>  /* P0.24 - Kolumn 2 */
            , <&gpio1  0 GPIO_ACTIVE_HIGH>  /* P1.00 - Kolumn 3 */
            ;
    };
};
